<div class="auth-background">
  <div class="auth-overlay"></div>
  <div class="container auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h1>⚙️ Edit Profile</h1>
        <p>Customize your display settings</p>
      </div>

      <% if @user.errors.any? %>
        <div class="alert alert-error">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: profile_path, method: :patch, class: 'auth-form' do |f| %>
        <div class="form-group">
          <label>Username</label>
          <input type="text" value="<%= @user.username %>" class="form-input" disabled>
          <span class="form-hint">Username cannot be changed</span>
        </div>

        <div class="form-group">
          <%= f.label :display_name, "Display Name" %>
          <%= f.text_field :display_name, placeholder: "How you want to be called", class: 'form-input' %>
          <span class="form-hint">Leave blank to show your username</span>
        </div>

        <button type="submit" class="btn-auth btn-primary">
          💾 Save Changes
        </button>
      <% end %>

      <div class="auth-footer">
        <%= link_to "← Back to Profile", profile_path, class: 'auth-link-secondary' %>
      </div>
    </div>
  </div>
</div>

<style>
.auth-background {
  min-height: 100vh;
  background: linear-gradient(135deg, #0a0a12 0%, #1a1a2e 40%, #16213e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 40px 20px;
}

.auth-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255, 200, 50, 0.08) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(100, 150, 255, 0.1) 0%, transparent 50%);
  pointer-events: none;
}

.auth-container {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 450px;
}

.auth-card {
  background: rgba(25, 25, 35, 0.95);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 16px;
  padding: 50px 40px;
  backdrop-filter: blur(10px);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}

.auth-header {
  text-align: center;
  margin-bottom: 35px;
}

.auth-header h1 {
  font-size: 2rem;
  color: #d4af37;
  margin-bottom: 10px;
  font-weight: 700;
}

.auth-header p {
  color: rgba(255, 255, 255, 0.7);
  font-size: 1rem;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-group label {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  font-size: 0.95rem;
}

.form-input {
  background: rgba(40, 40, 50, 0.8);
  border: 2px solid rgba(100, 100, 120, 0.3);
  border-radius: 10px;
  padding: 14px 16px;
  font-size: 1rem;
  color: #fff;
  transition: all 0.3s ease;
}

.form-input:focus {
  outline: none;
  border-color: #d4af37;
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
}

.form-input:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.form-hint {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.5);
}

.btn-auth {
  padding: 16px 24px;
  border-radius: 10px;
  font-size: 1.1rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
  margin-top: 10px;
}

.btn-primary {
  background: linear-gradient(135deg, #d4af37 0%, #f5d76e 50%, #d4af37 100%);
  color: #1a1a2e;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
}

.auth-footer {
  text-align: center;
  margin-top: 30px;
  padding-top: 25px;
  border-top: 1px solid rgba(100, 100, 120, 0.3);
}

.auth-link-secondary {
  color: rgba(255, 255, 255, 0.5);
  text-decoration: none;
  font-size: 0.9rem;
}

.auth-link-secondary:hover {
  color: #d4af37;
}

.alert {
  padding: 12px 16px;
  border-radius: 8px;
  margin-bottom: 20px;
  font-size: 0.9rem;
}

.alert-error {
  background: rgba(200, 50, 50, 0.2);
  border: 1px solid rgba(200, 50, 50, 0.4);
  color: #ff8888;
}

.alert-error ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
</style>

