<div class="gallery-reader-background">
  <div class="gallery-reader-overlay"></div>
  <div class="container stories-container">
    <div class="stories-header">
      <h1>📖 Stories & Chapters</h1>
      <p class="stories-description">
        Dive into the tales of heroes, gods, and monsters. Read about their adventures, battles, and destinies.
      </p>
    </div>

    <% if @bonus_chapters.any? %>
      <div class="chapter-category-section">
        <h2 class="category-title">📚 Bonus Chapters & Myths</h2>
        
        <div class="subcategory-grid">
          <% 
            # Sort subcategories by their first (lowest) chapter number
            sorted_subcategories = @bonus_chapters.sort_by do |subcategory, chapters|
              min_chapter = chapters.map { |ch| ch.chapter_number.to_f || 999.0 }.min
              min_chapter
            end
          %>
          
          <% sorted_subcategories.each do |subcategory, chapters| %>
            <div class="subcategory-card">
              <%= link_to subcategory_chapters_path(subcategory), class: 'subcategory-card-link' do %>
                <div class="subcategory-card-content">
                  <h3 class="subcategory-card-title"><%= subcategory %></h3>
                  <p class="subcategory-description"><%= @subcategory_info[subcategory] || 'TODO' %></p>
                  <div class="subcategory-stats">
                    <span class="chapter-count"><%= chapters.count %> <%= 'chapter'.pluralize(chapters.count) %></span>
                  </div>
                  <div class="subcategory-actions">
                    <span class="btn btn-primary">Read Chapters →</span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @other_chapters.any? %>
      <% @other_chapters.each do |category, chapters| %>
        <div class="chapter-category-section">
          <h2 class="category-title"><%= category.titleize.gsub('_', ' ') %></h2>
          
          <div class="chapters-grid">
            <% chapters.sort_by { |ch| ch.chapter_number.to_f || 999.0 }.each do |chapter| %>
              <div class="chapter-card">
                <%= link_to chapter_path(chapter), class: 'chapter-card-link' do %>
                  <div class="chapter-card-content">
                    <h4 class="chapter-title"><%= chapter.title %></h4>
                    <% if chapter.chapter_number.present? %>
                      <span class="chapter-number">Chapter <%= chapter.chapter_number %></span>
                    <% end %>
                    <div class="chapter-meta">
                      <span class="chapter-category-badge"><%= chapter.category.titleize.gsub('_', ' ') %></span>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @bonus_chapters.empty? && @other_chapters.empty? %>
      <div class="no-chapters">
        <p>No stories available yet. Check back soon!</p>
      </div>
    <% end %>

    <div class="back-navigation">
      <%= link_to '← Back to Home', root_path, class: 'btn btn-secondary' %>
    </div>
  </div>
</div>

<style>
.gallery-reader-background {
  min-height: 100vh;
  background: linear-gradient(135deg, #2c3e50 0%, #1a1a2e 100%);
  padding: 60px 0;
  position: relative;
}

.gallery-reader-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(2px);
  z-index: 0;
}

.stories-container {
  padding: 40px 20px;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.stories-header {
  text-align: center;
  margin-bottom: 50px;
  padding: 40px 30px;
  background: rgba(40, 40, 50, 0.8);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  border: 1px solid rgba(200, 200, 200, 0.2);
}

.stories-header h1 {
  font-size: 2.5rem;
  margin-bottom: 15px;
  color: #d4af37;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.stories-description {
  font-size: 1.1rem;
  color: rgba(255, 255, 255, 0.9);
  max-width: 600px;
  margin: 0 auto;
}

.chapter-category-section {
  margin-bottom: 50px;
  background: rgba(40, 40, 50, 0.75);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  padding: 30px;
  border: 1px solid rgba(200, 200, 200, 0.2);
}

.category-title {
  font-size: 1.8rem;
  color: #a8b9ff;
  margin-bottom: 30px;
  padding-bottom: 15px;
  border-bottom: 2px solid rgba(168, 185, 255, 0.3);
  text-align: center;
}

.subcategory-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 25px;
}

.subcategory-card {
  background: rgba(50, 50, 60, 0.7);
  backdrop-filter: blur(8px);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
  border: 2px solid rgba(200, 200, 200, 0.2);
}

.subcategory-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 20px rgba(212, 175, 55, 0.4);
  border-color: #d4af37;
  background: rgba(60, 60, 70, 0.85);
}

.subcategory-card-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.subcategory-card-content {
  padding: 25px;
}

.subcategory-card-title {
  font-size: 1.4rem;
  color: #d4af37;
  margin-bottom: 15px;
  font-weight: 600;
}

.subcategory-description {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 15px;
  line-height: 1.5;
  min-height: 48px;
}

.subcategory-stats {
  margin: 15px 0;
}

.chapter-count {
  display: inline-block;
  font-size: 0.9rem;
  color: #a8b9ff;
  font-weight: 600;
}

.subcategory-actions {
  margin-top: 20px;
  text-align: center;
}

.subcategory-actions .btn {
  display: inline-block;
  padding: 10px 20px;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 8px;
  font-weight: 600;
  transition: all 0.3s ease;
}

.subcategory-card:hover .subcategory-actions .btn {
  background: linear-gradient(135deg, #764ba2, #667eea);
  transform: scale(1.05);
}

.chapters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}

.chapter-card {
  background: rgba(50, 50, 60, 0.7);
  backdrop-filter: blur(8px);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
  border: 2px solid rgba(200, 200, 200, 0.2);
}

.chapter-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 16px rgba(212, 175, 55, 0.4);
  border-color: #d4af37;
  background: rgba(60, 60, 70, 0.85);
}

.chapter-card-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.chapter-card-content {
  padding: 20px;
}

.chapter-title {
  font-size: 1.1rem;
  color: #e0e0e0;
  margin-bottom: 10px;
  line-height: 1.4;
  font-weight: 600;
}

.chapter-number {
  display: inline-block;
  font-size: 0.85rem;
  color: #a8b9ff;
  font-weight: 600;
  margin-bottom: 12px;
}

.chapter-meta {
  margin-top: 12px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.chapter-category-badge {
  display: inline-block;
  padding: 4px 10px;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 15px;
  font-size: 0.75rem;
  font-weight: 600;
}

.no-chapters {
  text-align: center;
  padding: 60px 20px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 1.1rem;
  background: rgba(40, 40, 50, 0.75);
  backdrop-filter: blur(10px);
  border-radius: 12px;
}

.back-navigation {
  text-align: center;
  margin-top: 40px;
}

@media (max-width: 768px) {
  .stories-header h1 {
    font-size: 1.8rem;
  }
  
  .category-title {
    font-size: 1.4rem;
  }
  
  .subcategory-grid,
  .chapters-grid {
    grid-template-columns: 1fr;
  }
  
  .chapter-category-section {
    padding: 20px;
  }
}
</style>
