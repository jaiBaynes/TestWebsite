<div class="gallery-reader-background">
  <div class="gallery-reader-overlay"></div>
  <div class="container stories-container">
    <div class="locked-subcategory-modal">
      <div class="locked-modal-content">
        <div class="lock-icon">🔒</div>
        <h2 class="locked-title"><%= @locked_subcategory %></h2>
        <p class="locked-message">This chapter collection is locked. Please enter the password to access it.</p>
        
        <form id="unlockForm" class="unlock-form">
          <input 
            type="password" 
            id="passwordInput" 
            name="password" 
            placeholder="Enter password..."
            class="password-input"
            autocomplete="off"
          />
          <button type="submit" class="btn btn-unlock">Unlock</button>
        </form>
        
        <div id="errorMessage" class="error-message" style="display: none;"></div>
        
        <div class="back-navigation">
          <%= link_to '← Back to Stories', stories_path, class: 'btn btn-secondary' %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('unlockForm');
  const passwordInput = document.getElementById('passwordInput');
  const errorMessage = document.getElementById('errorMessage');
  const submitButton = form.querySelector('button[type="submit"]');
  
  // Focus on password input
  passwordInput.focus();
  
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const password = passwordInput.value;
    const subcategory = '<%= @locked_subcategory %>';
    const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
    
    // Disable button to prevent double-clicks
    submitButton.disabled = true;
    submitButton.textContent = '🔓 Unlocking...';
    errorMessage.style.display = 'none';
    
    fetch(`/stories/${encodeURIComponent(subcategory)}/unlock`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ password: password })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Redirect to the subcategory page
        window.location.href = `/stories/${encodeURIComponent(subcategory)}`;
      } else {
        // Show error message
        errorMessage.textContent = data.message || 'Incorrect password';
        errorMessage.style.display = 'block';
        passwordInput.value = '';
        passwordInput.focus();
        submitButton.disabled = false;
        submitButton.textContent = 'Unlock';
      }
    })
    .catch(error => {
      console.error('Error:', error);
      errorMessage.textContent = 'An error occurred. Please try again.';
      errorMessage.style.display = 'block';
      submitButton.disabled = false;
      submitButton.textContent = 'Unlock';
    });
  });
});
</script>

<style>
.gallery-reader-background {
  min-height: 100vh;
  background: linear-gradient(135deg, #2c3e50 0%, #1a1a2e 100%);
  padding: 60px 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-reader-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(2px);
  z-index: 0;
}

.stories-container {
  padding: 40px 20px;
  max-width: 600px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.locked-subcategory-modal {
  background: rgba(40, 40, 50, 0.95);
  backdrop-filter: blur(15px);
  border-radius: 16px;
  padding: 50px 40px;
  border: 2px solid rgba(212, 175, 55, 0.3);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
  text-align: center;
}

.locked-modal-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25px;
}

.lock-icon {
  font-size: 4rem;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

.locked-title {
  font-size: 2rem;
  color: #d4af37;
  margin: 0;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.locked-message {
  font-size: 1.1rem;
  color: rgba(255, 255, 255, 0.9);
  margin: 0;
  max-width: 400px;
}

.unlock-form {
  width: 100%;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.password-input {
  padding: 15px 20px;
  font-size: 1rem;
  border: 2px solid rgba(168, 185, 255, 0.3);
  border-radius: 8px;
  background: rgba(30, 30, 40, 0.8);
  color: white;
  text-align: center;
  transition: all 0.3s ease;
}

.password-input:focus {
  outline: none;
  border-color: #d4af37;
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
}

.password-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.btn-unlock {
  background: linear-gradient(135deg, #d4af37, #f4d03f);
  color: #1a1a2e;
  border: none;
  padding: 15px 40px;
  border-radius: 8px;
  font-size: 1.1rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);
}

.btn-unlock:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(212, 175, 55, 0.6);
  background: linear-gradient(135deg, #f4d03f, #d4af37);
}

.btn-unlock:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.error-message {
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.1);
  border: 1px solid rgba(255, 107, 107, 0.3);
  padding: 12px 20px;
  border-radius: 8px;
  font-size: 0.95rem;
  width: 100%;
  max-width: 400px;
}

.back-navigation {
  margin-top: 20px;
}

@media (max-width: 768px) {
  .locked-subcategory-modal {
    padding: 40px 25px;
  }
  
  .locked-title {
    font-size: 1.5rem;
  }
  
  .lock-icon {
    font-size: 3rem;
  }
  
  .locked-message {
    font-size: 1rem;
  }
}
</style>

