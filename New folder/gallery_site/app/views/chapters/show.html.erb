<div class="chapter-reader-background">
  <div class="chapter-reader-overlay"></div>
  
  <div class="chapter-reader-container">
    <div class="chapter-header">
      <div class="chapter-navigation-top">
        <% if @previous_chapter %>
          <%= link_to "← #{@previous_chapter.title}", chapter_path(@previous_chapter), class: 'btn btn-nav btn-prev' %>
        <% end %>
        
        <%= link_to 'Back to Stories', stories_path, class: 'btn btn-secondary btn-back-stories' %>
        
        <% if @next_chapter %>
          <%= link_to "#{@next_chapter.title} →", chapter_path(@next_chapter), class: 'btn btn-nav btn-next' %>
        <% end %>
      </div>
      
      <h1 class="chapter-main-title"><%= @chapter.title %></h1>
      
      <% if @chapter.chapter_number.present? %>
        <p class="chapter-subtitle">Chapter <%= @chapter.chapter_number %></p>
      <% end %>
      
      <div class="chapter-controls">
        <button class="tts-control-button" onclick="toggleChapterTTS()" title="Listen to this chapter">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
          </svg>
          <span id="ttsButtonText">Listen to Chapter</span>
        </button>
      </div>
    </div>
    
    <div class="chapter-content-wrapper">
      <div class="chapter-ornament">◆</div>
      
      <div class="chapter-content">
        <%= parse_chapter_content(@chapter.content) %>
      </div>
      
      <div class="chapter-ornament">◆</div>
    </div>
    
    <div class="chapter-navigation-bottom">
      <% locked_characters = @chapter.unlockable_characters.select(&:locked?) %>
      <% if locked_characters.any? %>
        <div class="chapter-unlock-info">
          <p>💎 Complete this chapter to unlock: <strong><%= locked_characters.map(&:name).join(', ') %></strong></p>
        </div>
      <% end %>
      
      <div class="chapter-bottom-buttons">
        <% if @previous_chapter %>
          <%= link_to "← #{@previous_chapter.title}", chapter_path(@previous_chapter), class: 'btn btn-nav btn-prev' %>
        <% end %>
        
        <%= link_to 'Back to Stories', stories_path, class: 'btn btn-secondary btn-back-stories' %>
        
        <% if @next_chapter %>
          <%= link_to "#{@next_chapter.title} →", chapter_path(@next_chapter), class: 'btn btn-nav btn-next' %>
        <% end %>
        
        <% if locked_characters.any? %>
          <button id="completeChapterBtn" class="btn btn-complete" data-chapter-slug="<%= @chapter.slug %>">
            ✨ Complete Chapter
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Image Zoom Modal -->
<div id="chapterImageZoomModal" class="chapter-image-zoom-modal" onclick="closeChapterImageZoom()">
  <button class="zoom-close" onclick="closeChapterImageZoom()">&times;</button>
  <img id="chapterZoomedImage" class="zoomed-image" src="" alt="">
</div>

<script>
// Store chapter text for TTS
const chapterText = <%= raw extract_plain_text_for_tts(@chapter.content).to_json %>;
let chapterSpeech = null;
let isSpeaking = false;

function toggleChapterTTS() {
  const button = document.querySelector('.tts-control-button');
  const buttonText = document.getElementById('ttsButtonText');
  
  if (isSpeaking) {
    // Stop speaking
    window.speechSynthesis.cancel();
    chapterSpeech = null;
    isSpeaking = false;
    button.classList.remove('tts-active');
    buttonText.textContent = 'Listen to Chapter';
  } else {
    // Start speaking
    if (!('speechSynthesis' in window)) {
      alert('Sorry, your browser does not support text-to-speech.');
      return;
    }
    
    chapterSpeech = new SpeechSynthesisUtterance(chapterText);
    
    // Configure speech
    chapterSpeech.rate = 1.0;
    chapterSpeech.pitch = 1.0;
    chapterSpeech.volume = 1.0;
    
    // Update UI when speech ends
    chapterSpeech.onend = function() {
      chapterSpeech = null;
      isSpeaking = false;
      button.classList.remove('tts-active');
      buttonText.textContent = 'Listen to Chapter';
    };
    
    // Handle errors
    chapterSpeech.onerror = function() {
      chapterSpeech = null;
      isSpeaking = false;
      button.classList.remove('tts-active');
      buttonText.textContent = 'Listen to Chapter';
    };
    
    // Start speaking
    window.speechSynthesis.speak(chapterSpeech);
    isSpeaking = true;
    button.classList.add('tts-active');
    buttonText.textContent = 'Stop Reading';
  }
}

// Stop TTS when leaving page
window.addEventListener('beforeunload', function() {
  if (chapterSpeech) {
    window.speechSynthesis.cancel();
  }
});

// Image Zoom Modal Functions
function openChapterImageZoom(imageSrc) {
  const modal = document.getElementById('chapterImageZoomModal');
  const zoomedImg = document.getElementById('chapterZoomedImage');
  
  zoomedImg.src = imageSrc;
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeChapterImageZoom() {
  const modal = document.getElementById('chapterImageZoomModal');
  modal.style.display = 'none';
  document.body.style.overflow = 'auto';
}

// Make all chapter images clickable for zoom
document.addEventListener('DOMContentLoaded', function() {
  const chapterImages = document.querySelectorAll('.chapter-artwork img, .chapter-content img:not(.chapter-artwork img)');
  
  chapterImages.forEach(function(img) {
    img.style.cursor = 'pointer';
    img.setAttribute('title', 'Click to view full size');
    
    img.addEventListener('click', function(e) {
      e.stopPropagation();
      openChapterImageZoom(this.src);
    });
  });
  
  // Close modal with Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeChapterImageZoom();
    }
  });
  
  // Handle Complete Chapter button
  const completeBtn = document.getElementById('completeChapterBtn');
  if (completeBtn) {
    completeBtn.addEventListener('click', function() {
      const chapterSlug = this.getAttribute('data-chapter-slug');
      const csrfToken = document.querySelector('meta[name="csrf-token"]').content;
      
      // Disable button to prevent double-clicks
      this.disabled = true;
      this.textContent = '⏳ Unlocking...';
      
      fetch(`/chapters/${chapterSlug}/complete`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success && data.unlocked.length > 0) {
          // Show unlock modal
          showChapterUnlockModal(data.unlocked);
          
          // Hide the unlock section
          const unlockInfo = document.querySelector('.chapter-unlock-info');
          if (unlockInfo) unlockInfo.remove();
          completeBtn.remove();
        } else {
          // No characters to unlock (shouldn't happen, but handle it)
          alert('No new characters to unlock!');
          this.disabled = false;
          this.textContent = '✨ Complete Chapter';
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Failed to unlock characters. Please try again.');
        this.disabled = false;
        this.textContent = '✨ Complete Chapter';
      });
    });
  }
});

// Show unlock modal for chapters - matches unlock system modal exactly
function showChapterUnlockModal(unlockedCharacters) {
  const modalHTML = `
    <div id="chapterUnlockModal" class="unlock-modal" style="display: flex;">
      <div class="unlock-modal-content">
        <button class="unlock-modal-close" onclick="closeChapterUnlockModal()">&times;</button>
        <h2 style="text-align: center; margin-bottom: 30px; color: #667eea;">🎉 Characters Unlocked!</h2>
        
        <div class="unlocked-characters-grid">
          ${unlockedCharacters.map(char => `
            <div class="unlocked-character-card">
              <a href="/galleries/${char.gallery_id}/images/${char.id}" style="text-decoration: none;">
                <img src="${char.image}" alt="${char.name}" class="unlocked-character-img" referrerpolicy="no-referrer">
                <h3>${char.name}</h3>
              </a>
            </div>
          `).join('')}
        </div>
        
        <div style="text-align: center; margin-top: 30px;">
          <button onclick="closeChapterUnlockModal()" class="btn btn-primary">Continue</button>
        </div>
      </div>
    </div>
  `;
  
  document.body.insertAdjacentHTML('beforeend', modalHTML);
}

function closeChapterUnlockModal() {
  const modal = document.getElementById('chapterUnlockModal');
  if (modal) {
    modal.remove();
  }
}
</script>

<style>
