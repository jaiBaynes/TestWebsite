}

.chapter-bottom-buttons {
  display: flex;
  gap: 20px;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

.btn-complete {
  background: linear-gradient(135deg, #d4af37, #f4d03f);
  color: #1a1a2e;
  border: none;
  padding: 15px 40px;
