  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 50%, rgba(102, 126, 234, 0.1), transparent 70%);
  pointer-events: none;
}

.chapter-reader-container {
  max-width: 900px;
  margin: 0 auto;
