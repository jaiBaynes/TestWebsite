}

.games-container {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.games-header {
  text-align: center;
  margin-bottom: 50px;
  padding: 40px 30px;
  background: rgba(40, 40, 50, 0.8);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  border: 1px solid rgba(200, 200, 200, 0.2);
}

.games-header h1 {
  font-size: 2.5rem;
  color: #d4af37;
  margin-bottom: 15px;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.games-header p {
  font-size: 1.2rem;
  color: rgba(255, 255, 255, 0.9);
}

.game-section {
  margin-bottom: 40px;
}

.game-card {
  background: rgba(40, 40, 50, 0.75);
  backdrop-filter: blur(10px);
  border-radius: 12px;
  padding: 40px;
  border: 1px solid rgba(200, 200, 200, 0.2);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
