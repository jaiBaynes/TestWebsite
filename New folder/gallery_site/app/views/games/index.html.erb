  box-shadow: 0 10px 30px rgba(255, 221, 68, 0.3);
}

.boss-preview.aquila-preview:hover {
  border-color: #88aaff;
  box-shadow: 0 10px 30px rgba(136, 170, 255, 0.3);
}

.boss-preview.hades-preview:hover {
  border-color: #ff6644;
  box-shadow: 0 10px 30px rgba(255, 102, 68, 0.3);
}

.boss-preview.hydra-preview:hover {
  border-color: #66ff66;
  box-shadow: 0 10px 30px rgba(102, 255, 102, 0.3);
}

.boss-preview-icon {
  font-size: 3rem;
  margin-bottom: 10px;
}

.boss-preview-name {
  font-size: 1.2rem;
  font-weight: 700;
  color: #d4af37;
