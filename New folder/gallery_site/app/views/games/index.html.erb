}

.game-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.game-card.coming-soon {
  opacity: 0.7;
}

/* Boss Fights Card Styles */
.boss-fights-card {
  border-color: rgba(212, 175, 55, 0.3);
}

.boss-preview-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 30px;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
}

.boss-preview {
  background: rgba(30, 30, 40, 0.8);
  border: 2px solid rgba(100, 100, 120, 0.3);
  border-radius: 12px;
  padding: 25px 15px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.boss-preview:hover {
