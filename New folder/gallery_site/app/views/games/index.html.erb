<div class="games-background">
  <div class="games-overlay"></div>
  
  <div class="container games-container">
    <div class="games-header">
      <h1>🎮 Games & Activities</h1>
      <p>Enjoy interactive games featuring the characters you've unlocked!</p>
    </div>
    
    <!-- Random Character Generator Game -->
    <div class="game-section">
      <div class="game-card">
        <div class="game-card-header">
          <h2>🎲 Random Character Generator</h2>
          <p>Generate a random team of 4 characters from your unlocked collection!</p>
        </div>
        
        <div class="game-controls">
          <button id="generateButton" class="btn-generate" onclick="generateRandomCharacters()">
            ✨ Generate Random Team
          </button>
        </div>
        
        <div id="characterGrid" class="character-grid">
          <div class="character-slot empty-slot">
            <div class="slot-placeholder">?</div>
          </div>
          <div class="character-slot empty-slot">
            <div class="slot-placeholder">?</div>
          </div>
          <div class="character-slot empty-slot">
            <div class="slot-placeholder">?</div>
          </div>
          <div class="character-slot empty-slot">
            <div class="slot-placeholder">?</div>
          </div>
        </div>
        
        <div id="loadingMessage" class="loading-message" style="display: none;">
          <div class="spinner"></div>
          <p>Generating your team...</p>
        </div>
      </div>
    </div>
    
    <!-- Boss Fights Game Section -->
    <div class="game-section">
      <div class="game-card boss-fights-card">
        <div class="game-card-header">
          <h2>⚔️ Boss Fights</h2>
          <p>Battle legendary Greek gods and mythical creatures! Choose your opponent and test your skills.</p>
        </div>
        
        <div class="boss-preview-grid">
          <div class="boss-preview zeus-preview" onclick="launchBossFight('Zeus')">
            <div class="boss-preview-icon">⚡</div>
            <div class="boss-preview-name">Zeus</div>
            <div class="boss-preview-difficulty hard">Hard</div>
          </div>
          <div class="boss-preview aquila-preview" onclick="launchBossFight('Aquila')">
            <div class="boss-preview-icon">🦅</div>
            <div class="boss-preview-name">Aquila</div>
            <div class="boss-preview-difficulty easy">Easy</div>
          </div>
          <div class="boss-preview hades-preview" onclick="launchBossFight('Hades')">
            <div class="boss-preview-icon">🔥</div>
            <div class="boss-preview-name">Hades</div>
            <div class="boss-preview-difficulty medium">Medium</div>
          </div>
          <div class="boss-preview hydra-preview" onclick="launchBossFight('Hydra')">
            <div class="boss-preview-icon">🐍</div>
            <div class="boss-preview-name">Hydra</div>
            <div class="boss-preview-difficulty medium">Medium</div>
          </div>
        </div>

        <div class="game-controls">
          <a href="/games/bossfights/index.html" class="btn-generate" target="_blank">
            🎮 Open Full Boss Fight Arena
          </a>
          <button id="embedBossBtn" class="btn-generate btn-secondary-style" onclick="toggleBossEmbed()">
            📺 Play Embedded
          </button>
        </div>

        <div id="bossContainer" style="display:none; margin-top:20px;">
          <div class="embed-controls">
            <button onclick="closeBossEmbed()" class="btn-close-embed">✕ Close</button>
          </div>
          <iframe id="bossIframe" src="" width="100%" height="750" frameborder="0" allow="autoplay; fullscreen" style="border-radius: 12px; border: 2px solid rgba(212, 175, 55, 0.3);"></iframe>
        </div>
      </div>
    </div>

    <!-- Placeholder for future games -->
    <div class="game-section">
      <div class="game-card coming-soon">
        <div class="game-card-header">
          <h2>🔮 More Games Coming Soon!</h2>
          <p>Stay tuned for more interactive activities and minigames.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let isGenerating = false;

function generateRandomCharacters() {
  if (isGenerating) return;
  
  isGenerating = true;
  const button = document.getElementById('generateButton');
  const grid = document.getElementById('characterGrid');
  const loadingMessage = document.getElementById('loadingMessage');
  
  // Disable button and show loading
  button.disabled = true;
  button.textContent = '⏳ Generating...';
  loadingMessage.style.display = 'block';
  
  // Clear current grid with animation
  grid.style.opacity = '0';
  
  // Fetch random characters
  fetch('<%= games_random_characters_path %>', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': '<%= form_authenticity_token %>',
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    // Wait for fade out animation
    setTimeout(() => {
      displayCharacters(data.characters);
      
      // Fade in with new characters
      grid.style.opacity = '1';
      loadingMessage.style.display = 'none';
      
      // Re-enable button
      button.disabled = false;
      button.textContent = '✨ Generate Random Team';
      isGenerating = false;
    }, 300);
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Failed to generate characters. Please try again.');
    loadingMessage.style.display = 'none';
    grid.style.opacity = '1';
    button.disabled = false;
    button.textContent = '✨ Generate Random Team';
    isGenerating = false;
  });
}

function displayCharacters(characters) {
  const grid = document.getElementById('characterGrid');
  grid.innerHTML = '';
  
  characters.forEach((character, index) => {
    const slot = document.createElement('div');
    slot.className = 'character-slot filled-slot';
    slot.style.animationDelay = `${index * 0.1}s`;
    
    slot.innerHTML = `
      <a href="/galleries/${character.gallery_id}/images/${character.id}" class="character-link-wrapper">
        <img src="${character.image}" alt="${character.name}" class="character-image" referrerpolicy="no-referrer" 
             onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22300%22/%3E%3Crect fill=%22%23e9ecef%22 width=%22300%22 height=%22300%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 font-size=%2220%22 fill=%22%23999%22 text-anchor=%22middle%22 dy=%22.3em%22%3E[Image]%3C/text%3E%3C/svg%3E'">
        <div class="character-name-overlay">
          <p>${character.name}</p>
        </div>
      </a>
    `;
    
    grid.appendChild(slot);
  });
}

// Boss Fights helpers
function launchBossFight(bossName) {
  // Open in new window with boss pre-selected via hash
  window.open(`/games/bossfights/index.html#boss=${bossName}`, '_blank');
}

function toggleBossEmbed() {
  const container = document.getElementById('bossContainer');
  const iframe = document.getElementById('bossIframe');
  const btn = document.getElementById('embedBossBtn');
  
  if (container.style.display === 'none') {
    container.style.display = 'block';
    iframe.src = '/games/bossfights/index.html';
    btn.textContent = '📺 Hide Game';
    container.scrollIntoView({behavior: 'smooth'});
  } else {
    closeBossEmbed();
  }
}

function closeBossEmbed() {
  const container = document.getElementById('bossContainer');
  const iframe = document.getElementById('bossIframe');
  const btn = document.getElementById('embedBossBtn');
  
  container.style.display = 'none';
  iframe.src = '';
  btn.textContent = '📺 Play Embedded';
}

</script>

<style>
