<div class="admin-background">
  <div class="container admin-container">
    <div class="admin-header">
      <h1>🛠️ Admin Panel - User Management</h1>
      <p>Set points, reset progress, and manage user accounts for testing</p>
    </div>

    <% if flash[:notice] %>
      <div class="admin-alert admin-alert-success"><%= flash[:notice] %></div>
    <% end %>

    <div class="admin-section">
      <h2>📊 Rank Thresholds Reference</h2>
      <div class="rank-reference">
        <% User::RANKS.each do |rank| %>
          <div class="rank-ref-item" style="--rank-color: <%= rank[:color] %>;">
            <span class="rank-ref-icon"><%= rank[:icon] %></span>
            <span class="rank-ref-name"><%= rank[:name] %></span>
            <span class="rank-ref-pts"><%= number_with_delimiter(rank[:threshold]) %> pts</span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="admin-section">
      <h2>👥 All Users (<%= @users.count %>)</h2>
      <div class="users-table-container">
        <table class="users-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Username</th>
              <th>Rank</th>
              <th>Points</th>
              <th>Set Points</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td><%= user.id %></td>
                <td>
                  <strong><%= user.display_name_or_username %></strong>
                  <% if user.display_name.present? %>
                    <br><small style="color: rgba(255,255,255,0.5);">@<%= user.username %></small>
                  <% end %>
                </td>
                <td>
                  <span class="user-rank-badge" style="color: <%= user.rank_color %>;">
                    <%= user.rank_icon %> <%= user.rank_name %>
                  </span>
                </td>
                <td class="points-cell"><%= number_with_delimiter(user.points) %></td>
                <td>
                  <%= form_with url: admin_set_points_path(user), method: :post, local: true, class: 'set-points-form' do %>
                    <input type="number" name="points" value="<%= user.points %>" min="0" max="1000000" class="points-input">
                    <button type="submit" class="btn-admin btn-set">Set</button>
                  <% end %>
                </td>
                <td>
                  <div class="quick-buttons">
                    <% User::RANKS.each do |rank| %>
                      <%= button_to admin_set_points_path(user), method: :post, params: { points: rank[:threshold] }, class: 'btn-admin btn-quick', title: "Set to #{rank[:name]} (#{rank[:threshold]} pts)" do %>
                        <%= rank[:icon] %>
                      <% end %>
                    <% end %>
                  </div>
                  <%= button_to admin_reset_progress_path(user), method: :post, class: 'btn-admin btn-danger', data: { confirm: "Reset ALL progress for #{user.username}? This cannot be undone!" } do %>
                    🗑️ Reset
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="admin-section">
      <h2>📝 Point Values Reference</h2>
      <div class="point-values-grid">
        <div class="point-value-card">
          <span class="pv-icon">📚</span>
          <span class="pv-label">Chapter Read</span>
          <span class="pv-value"><%= User::POINT_VALUES[:chapter_read] %> pts</span>
        </div>
        <div class="point-value-card">
          <span class="pv-icon">👁️</span>
          <span class="pv-label">Character View</span>
          <span class="pv-value"><%= User::POINT_VALUES[:character_view] %> pts</span>
        </div>
        <div class="point-value-card">
          <span class="pv-icon">🔓</span>
          <span class="pv-label">Character Unlock</span>
          <span class="pv-value"><%= User::POINT_VALUES[:character_unlock] %> pts</span>
        </div>
        <div class="point-value-card">
          <span class="pv-icon">⚔️</span>
          <span class="pv-label">Boss (Easy)</span>
          <span class="pv-value"><%= User::POINT_VALUES[:boss_easy] %> pts</span>
        </div>
        <div class="point-value-card">
          <span class="pv-icon">⚔️</span>
          <span class="pv-label">Boss (Medium)</span>
          <span class="pv-value"><%= User::POINT_VALUES[:boss_medium] %> pts</span>
        </div>
        <div class="point-value-card">
          <span class="pv-icon">⚔️</span>
          <span class="pv-label">Boss (Hard)</span>
          <span class="pv-value"><%= User::POINT_VALUES[:boss_hard] %> pts</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.admin-background {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40px 20px;
}

.admin-container {
  max-width: 1200px;
  margin: 0 auto;
}

.admin-header {
  text-align: center;
  margin-bottom: 40px;
}

.admin-header h1 {
  color: #d4af37;
  font-size: 2.2rem;
  margin-bottom: 10px;
}

.admin-header p {
  color: rgba(255, 255, 255, 0.7);
}

.admin-alert {
  padding: 15px 20px;
  border-radius: 10px;
  margin-bottom: 25px;
  font-weight: 600;
}

.admin-alert-success {
  background: rgba(50, 200, 100, 0.2);
  border: 1px solid rgba(50, 200, 100, 0.4);
  color: #44dd88;
}

.admin-section {
  background: rgba(30, 30, 45, 0.9);
  border: 1px solid rgba(100, 100, 120, 0.3);
  border-radius: 16px;
  padding: 30px;
  margin-bottom: 30px;
}

.admin-section h2 {
  color: #d4af37;
  margin-bottom: 20px;
  font-size: 1.4rem;
}

/* Rank Reference */
.rank-reference {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
}

.rank-ref-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: rgba(50, 50, 60, 0.6);
  border-radius: 20px;
  border: 1px solid var(--rank-color);
}

.rank-ref-icon { font-size: 1.2rem; }
.rank-ref-name { color: var(--rank-color); font-weight: 600; }
.rank-ref-pts { color: rgba(255, 255, 255, 0.5); font-size: 0.85rem; }

/* Users Table */
.users-table-container {
  overflow-x: auto;
}

.users-table {
  width: 100%;
  border-collapse: collapse;
}

.users-table th,
.users-table td {
  padding: 15px 12px;
  text-align: left;
  border-bottom: 1px solid rgba(100, 100, 120, 0.3);
}

.users-table th {
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
  background: rgba(40, 40, 55, 0.8);
}

.users-table td {
  color: rgba(255, 255, 255, 0.9);
}

.users-table tr:hover {
  background: rgba(50, 50, 65, 0.5);
}

.user-rank-badge {
  font-weight: 600;
}

.points-cell {
  font-weight: 700;
  color: #d4af37 !important;
}

.set-points-form {
  display: flex;
  gap: 8px;
  align-items: center;
}

.points-input {
  width: 100px;
  padding: 8px 10px;
  border: 1px solid rgba(100, 100, 120, 0.4);
  border-radius: 6px;
  background: rgba(40, 40, 55, 0.8);
  color: #fff;
  font-size: 0.95rem;
}

.points-input:focus {
  outline: none;
  border-color: #d4af37;
}

.btn-admin {
  padding: 8px 14px;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  font-weight: 600;
  font-size: 0.85rem;
  transition: all 0.2s ease;
}

.btn-set {
  background: #d4af37;
  color: #1a1a2e;
}

.btn-set:hover {
  background: #f5d76e;
}

.btn-danger {
  background: rgba(200, 50, 50, 0.3);
  color: #ff6666;
  border: 1px solid rgba(200, 50, 50, 0.5);
}

.btn-danger:hover {
  background: rgba(200, 50, 50, 0.5);
}

.quick-buttons {
  display: flex;
  gap: 4px;
  margin-bottom: 8px;
}

.btn-quick {
  padding: 6px 10px;
  background: rgba(60, 60, 75, 0.8);
  color: #fff;
  border: 1px solid rgba(100, 100, 120, 0.4);
  font-size: 1rem;
}

.btn-quick:hover {
  background: rgba(80, 80, 95, 0.8);
  border-color: #d4af37;
}

/* Point Values Grid */
.point-values-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 15px;
}

.point-value-card {
  background: rgba(50, 50, 65, 0.6);
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  border: 1px solid rgba(100, 100, 120, 0.3);
}

.pv-icon { font-size: 1.8rem; display: block; margin-bottom: 8px; }
.pv-label { display: block; color: rgba(255, 255, 255, 0.7); font-size: 0.9rem; margin-bottom: 5px; }
.pv-value { display: block; color: #d4af37; font-weight: 700; font-size: 1.1rem; }

@media (max-width: 768px) {
  .users-table th:nth-child(1),
  .users-table td:nth-child(1) { display: none; }
  
  .quick-buttons { flex-wrap: wrap; }
}
</style>

