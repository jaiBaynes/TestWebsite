<div class="container">
  <div class="header">
    <h1><%= @category.titleize %></h1>
  </div>

  <% if @galleries.any? %>
    <div class="galleries-grid">
      <% @galleries.each do |gallery| %>
        <div class="gallery-card" style="background-image: url('<%= gallery.background_image.presence || '/images/characters/hades_2.png' %>');">
          <div class="gallery-card-overlay"></div>
          <div class="gallery-card-content">
            <h2><%= link_to gallery.title, gallery_path(gallery) %></h2>
            <p><%= truncate(gallery.description, length: 100) %></p>
            <p class="gallery-stats"><%= gallery.images.unlocked.count %> <%= @category == 'characters' ? 'characters' : 'items' %></p>
            <div class="gallery-actions">
              <%= link_to 'View Gallery', gallery_path(gallery), class: 'btn btn-primary' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="no-galleries">No <%= @category %> available yet.</p>
  <% end %>
</div>

