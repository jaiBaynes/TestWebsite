<div class="home-container">
  <div class="hero">
    <h1>Welcome to Gallery Site</h1>
    <p>A simple and beautiful image gallery application built with Ruby on Rails</p>
    <%= link_to 'Explore Galleries', galleries_path, class: 'btn btn-primary btn-large' %>
  </div>

  <div class="features">
    <div class="feature">
      <h3>📸 Create Galleries</h3>
      <p>Organize your images into themed galleries</p>
    </div>
    <div class="feature">
      <h3>🖼️ Upload Images</h3>
      <p>Add images with custom captions to your galleries</p>
    </div>
    <div class="feature">
      <h3>✨ Manage Content</h3>
      <p>Edit or delete galleries and images easily</p>
    </div>
  </div>
</div>
