<!DOCTYPE html>
<html>
  <head>
    <title>Gallery Site - Image Gallery Application</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    
    <script>
      // Global script to manage gallery audio state across all pages
      (function() {
        const currentGalleryKey = 'current_gallery_id';
        const currentPageGalleryId = '<%= @gallery.id if defined?(@gallery) && @gallery %>';
        const lastGalleryId = sessionStorage.getItem(currentGalleryKey);
        
        // If we had a previous gallery and now we're on a different gallery (or no gallery)
        if (lastGalleryId && lastGalleryId !== currentPageGalleryId) {
          // Clear the previous gallery's audio state
          const oldStorageKey = 'gallery_audio_' + lastGalleryId;
          sessionStorage.removeItem(oldStorageKey);
        }
        
        // Update current gallery (or clear if no gallery on this page)
        if (currentPageGalleryId) {
          sessionStorage.setItem(currentGalleryKey, currentPageGalleryId);
        } else {
          sessionStorage.removeItem(currentGalleryKey);
        }
      })();
    </script>
  </head>

  <body>
    <header>
      <div class="navbar">
        <div class="navbar-brand">
          <h1><%= link_to "🏛️ Mythology Archive", root_path %></h1>
        </div>
        <nav class="navbar-nav">
          <%= link_to "Home", root_path %> |
          <%= link_to "Characters", characters_path %> |
          <%= link_to "Locations", locations_path %> |
          <%= link_to "Items", items_path %> |
          <%= link_to "📖 Stories", stories_path %> |
          <%= link_to "🎮 Games", games_path %> |
          <%= link_to "🔓 Unlock System", unlocks_path, style: "color: #ffcc00;" %> |
          <%= link_to "🛠️ Admin", admin_path, style: "color: #ff6666;" %>
        </nav>
        <div class="navbar-user">
          <% if logged_in? %>
            <div class="user-status" id="user-status">
              <span class="user-rank-icon" style="color: <%= current_user.rank_color %>;">
                <%= current_user.rank_icon %>
              </span>
              <span class="user-points">
                <span id="points-display"><%= number_with_delimiter(current_user.points) %></span> pts
              </span>
              <%= link_to profile_path, class: 'user-profile-link' do %>
                <span class="user-name"><%= current_user.display_name_or_username %></span>
              <% end %>
            </div>
          <% else %>
            <div class="auth-links">
              <%= link_to "Log In", login_path, class: 'auth-link' %>
              <%= link_to "Sign Up", signup_path, class: 'auth-link auth-link-primary' %>
            </div>
          <% end %>
        </div>
      </div>
    </header>

    <% if notice %>
      <div class="alert notice">
        <%= notice %>
      </div>
    <% end %>

    <% if alert %>
      <div class="alert">
        <%= alert %>
      </div>
    <% end %>

    <%= yield %>
    
    <% if session[:newly_unlocked].present? && session[:newly_unlocked].any? %>
      <% unlocked_characters = Image.where(id: session[:newly_unlocked]) %>
      <div id="unlockModal" class="unlock-modal" style="display: flex;">
        <div class="unlock-modal-content">
          <button class="unlock-modal-close" onclick="closeUnlockModal()">&times;</button>
          <h2 style="text-align: center; margin-bottom: 30px; color: #667eea;">🎉 Characters Unlocked!</h2>
          
          <div class="unlocked-characters-grid">
            <% unlocked_characters.each do |character| %>
              <div class="unlocked-character-card">
                <%= link_to gallery_image_path(character.gallery_id, character.id), style: "text-decoration: none;" do %>
                  <img src="<%= character.thumbnail_url %>" alt="<%= character.name %>" class="unlocked-character-img" referrerpolicy="no-referrer">
                  <h3><%= character.name %></h3>
                <% end %>
              </div>
            <% end %>
          </div>
          
          <div style="text-align: center; margin-top: 30px;">
            <button onclick="closeUnlockModal()" class="btn btn-primary">Continue</button>
          </div>
        </div>
      </div>
      
      <script>
        function closeUnlockModal() {
          document.getElementById('unlockModal').style.display = 'none';
          // Clear the session data
          clearUnlockSession();
        }
        
        function clearUnlockSession() {
          // Clear the session data
          fetch('<%= clear_unlocked_session_path %>', {
            method: 'POST',
            headers: {
              'X-CSRF-Token': '<%= form_authenticity_token %>',
              'Content-Type': 'application/json'
            }
          });
        }
      </script>
    <% end %>
    
    <!-- Rank Up Celebration Modal -->
    <% info = rank_up_info if logged_in? %>
    <% if info && info[:new_rank] && info[:old_rank] %>
      <div id="rankUpModal" class="rank-up-modal" style="display: flex;">
        <div class="rank-up-modal-content">
          <div class="rank-up-particles"></div>
          <div class="rank-up-glow" style="--glow-color: <%= info[:new_rank][:color] %>;"></div>
          
          <h2 class="rank-up-title">🎉 RANK UP! 🎉</h2>
          
          <div class="rank-transition">
            <div class="old-rank" style="color: <%= info[:old_rank][:color] %>;">
              <span class="rank-icon"><%= info[:old_rank][:icon] %></span>
              <span class="rank-name"><%= info[:old_rank][:name] %></span>
            </div>
            <div class="rank-arrow">➜</div>
            <div class="new-rank" style="color: <%= info[:new_rank][:color] %>;">
              <span class="rank-icon"><%= info[:new_rank][:icon] %></span>
              <span class="rank-name"><%= info[:new_rank][:name] %></span>
            </div>
          </div>
          
          <p class="rank-up-message">
            Congratulations! You've ascended to <strong style="color: <%= info[:new_rank][:color] %>;"><%= info[:new_rank][:name] %></strong>!
          </p>
          
          <button onclick="closeRankUpModal()" class="btn-rank-up">Continue Your Journey</button>
        </div>
      </div>
      
      <script>
        function closeRankUpModal() {
          const modal = document.getElementById('rankUpModal');
          modal.style.opacity = '0';
          setTimeout(() => modal.style.display = 'none', 300);
        }
        
        // Auto-close after 8 seconds
        setTimeout(() => {
          const modal = document.getElementById('rankUpModal');
          if (modal && modal.style.display !== 'none') {
            closeRankUpModal();
          }
        }, 8000);
      </script>
      
      <style>
        .rank-up-modal {
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(0, 0, 0, 0.9);
          z-index: 10001;
          display: flex;
          justify-content: center;
          align-items: center;
          animation: rankUpFadeIn 0.5s ease;
          transition: opacity 0.3s ease;
        }
        
        @keyframes rankUpFadeIn {
          from { opacity: 0; }
          to { opacity: 1; }
        }
        
        .rank-up-modal-content {
          position: relative;
          background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
          padding: 60px 80px;
          border-radius: 24px;
          text-align: center;
          max-width: 500px;
          border: 2px solid var(--glow-color, #d4af37);
          box-shadow: 0 0 60px var(--glow-color, #d4af37),
                      0 0 120px rgba(212, 175, 55, 0.3);
          animation: rankUpPulse 2s ease-in-out infinite;
          overflow: hidden;
        }
        
        @keyframes rankUpPulse {
          0%, 100% { box-shadow: 0 0 60px var(--glow-color, #d4af37), 0 0 120px rgba(212, 175, 55, 0.3); }
          50% { box-shadow: 0 0 80px var(--glow-color, #d4af37), 0 0 160px rgba(212, 175, 55, 0.5); }
        }
        
        .rank-up-glow {
          position: absolute;
          top: -50%;
          left: -50%;
          width: 200%;
          height: 200%;
          background: radial-gradient(circle, var(--glow-color) 0%, transparent 70%);
          opacity: 0.1;
          animation: rankUpRotate 10s linear infinite;
          pointer-events: none;
        }
        
        @keyframes rankUpRotate {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }
        
        .rank-up-title {
          font-size: 2.5rem;
          color: #fff;
          margin-bottom: 30px;
          text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
          animation: rankUpBounce 0.6s ease;
        }
        
        @keyframes rankUpBounce {
          0% { transform: scale(0.5); opacity: 0; }
          50% { transform: scale(1.2); }
          100% { transform: scale(1); opacity: 1; }
        }
        
        .rank-transition {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 30px;
          margin-bottom: 30px;
        }
        
        .old-rank, .new-rank {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 8px;
        }
        
        .old-rank {
          opacity: 0.6;
        }
        
        .new-rank {
          animation: rankUpNewRank 1s ease 0.3s both;
        }
        
        @keyframes rankUpNewRank {
          0% { transform: scale(0.5); opacity: 0; }
          50% { transform: scale(1.3); }
          100% { transform: scale(1); opacity: 1; }
        }
        
        .rank-icon {
          font-size: 3rem;
        }
        
        .new-rank .rank-icon {
          font-size: 4rem;
          filter: drop-shadow(0 0 15px currentColor);
        }
        
        .rank-name {
          font-size: 1.2rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 2px;
        }
        
        .new-rank .rank-name {
          font-size: 1.5rem;
        }
        
        .rank-arrow {
          font-size: 2rem;
          color: #d4af37;
          animation: rankUpArrow 1s ease infinite;
        }
        
        @keyframes rankUpArrow {
          0%, 100% { transform: translateX(0); }
          50% { transform: translateX(10px); }
        }
        
        .rank-up-message {
          color: rgba(255, 255, 255, 0.9);
          font-size: 1.1rem;
          margin-bottom: 30px;
        }
        
        .btn-rank-up {
          padding: 16px 40px;
          font-size: 1.1rem;
          font-weight: 700;
          background: linear-gradient(135deg, #d4af37, #f5d76e);
          color: #1a1a2e;
          border: none;
          border-radius: 30px;
          cursor: pointer;
          transition: all 0.3s ease;
        }
        
        .btn-rank-up:hover {
          transform: translateY(-3px);
          box-shadow: 0 10px 30px rgba(212, 175, 55, 0.5);
        }
        
        @media (max-width: 600px) {
          .rank-up-modal-content {
            padding: 40px 30px;
            margin: 20px;
          }
          .rank-up-title { font-size: 1.8rem; }
          .rank-icon { font-size: 2rem; }
          .new-rank .rank-icon { font-size: 3rem; }
        }
      </style>
    <% end %>
    
    <!-- Progress Sync Script - Syncs localStorage data with server -->
    <% if logged_in? %>
      <script>
        (function syncProgress() {
          // Check if BossFightProgress helper exists
          if (typeof window.BossFightProgress !== 'undefined') {
            const unsynced = window.BossFightProgress.getUnsynced();
            if (unsynced.length > 0) {
              console.log(`Found ${unsynced.length} unsynced boss defeats, syncing...`);
              window.BossFightProgress.syncAll().then(result => {
                if (result.success) {
                  console.log(`✓ Synced ${result.synced} victories (+${result.data?.points_awarded || 0} pts)`);
                  // Update header if points were awarded
                  if (result.data?.total_points) {
                    const pointsDisplay = document.getElementById('points-display');
                    if (pointsDisplay) {
                      pointsDisplay.textContent = result.data.total_points.toLocaleString();
                      pointsDisplay.classList.add('points-earned');
                      setTimeout(() => pointsDisplay.classList.remove('points-earned'), 500);
                    }
                  }
                }
              });
            }
          }
          
          // Listen for points earned events
          window.addEventListener('pointsEarned', function(e) {
            const pointsDisplay = document.getElementById('points-display');
            if (pointsDisplay && e.detail?.total_points) {
              pointsDisplay.textContent = e.detail.total_points.toLocaleString();
              pointsDisplay.classList.add('points-earned');
              setTimeout(() => pointsDisplay.classList.remove('points-earned'), 500);
            }
          });
        })();
      </script>
    <% end %>
    
    <!-- Unlock Modal Styles - Always loaded for chapter unlocks -->
    <style>
      .unlock-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.85);
        z-index: 10000;
        display: flex;
        justify-content: center;
        align-items: center;
        animation: fadeIn 0.3s ease;
      }
      
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      
      .unlock-modal-content {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 40px;
        border-radius: 20px;
        max-width: 800px;
        max-height: 80vh;
        overflow-y: auto;
        position: relative;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        animation: slideUp 0.4s ease;
      }
      
      @keyframes slideUp {
        from { transform: translateY(50px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      
      .unlock-modal-close {
        position: absolute;
        top: 15px;
        right: 20px;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        font-size: 2em;
        cursor: pointer;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
      }
      
      .unlock-modal-close:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: rotate(90deg);
      }
      
      .unlock-modal h2 {
        color: white !important;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }
      
      .unlocked-characters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 20px;
        margin: 20px 0;
      }
      
      .unlocked-character-card {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        transition: all 0.3s ease;
        border: 2px solid rgba(255, 255, 255, 0.3);
        cursor: pointer;
      }
      
      .unlocked-character-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.25);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        border-color: rgba(255, 255, 255, 0.6);
      }
      
      .unlocked-character-card a {
        display: block;
        color: inherit;
      }
      
      .unlocked-character-img {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 10px;
        border: 2px solid rgba(255, 255, 255, 0.5);
      }
      
      .unlocked-character-card h3 {
        color: white;
        margin: 0;
        font-size: 1.1em;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
      }
    </style>
  </body>
</html>
